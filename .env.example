# Copia este archivo a .env en la raíz para usar Docker Compose.
POSTGRES_DB=pulsepass
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Correo con formato válido para iniciar sesión en pgAdmin.
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# Pega una clave aleatoria de al menos 32 bytes codificada en Base64.
PULSEPASS_JWT_SECRET_BASE64=

# Puertos de Windows. Puedes cambiarlos si otro proyecto los ocupa.
PULSEPASS_DB_PORT=5432
PULSEPASS_BACKEND_PORT=8080
PULSEPASS_PGADMIN_PORT=5050
